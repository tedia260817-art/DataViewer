@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1 class="text-center mt-4">Welcome to DataViewer</h1>

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-6 col-md-3">
            <div class="card text-center p-3" @onclick="NavigateToAlbums"
                style="cursor: pointer; border: none; background: none;">
                <div class="card-body">
                    <span class="bi bi-folder" style="font-size: 4rem; display: block;"></span>
                    <h5 class="mt-2">Albums</h5>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card text-center p-3" @onclick="NavigateToPosts"
                style="cursor: pointer; border: none; background: none;">
                <div class="card-body">
                    <span class="bi bi-file-earmark-text" style="font-size: 4rem; display: block;"></span>
                    <h5 class="mt-2">Posts</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private void NavigateToAlbums()
    {
        Navigation.NavigateTo("/albums");
    }

    private void NavigateToPosts()
    {
        Navigation.NavigateTo("/posts");
    }
}
