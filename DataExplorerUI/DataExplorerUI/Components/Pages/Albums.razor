@page "/albums"
@inject AlbumService AlbumService
@rendermode InteractiveServer

@using DataExplorerModels;

<h3 class="mt-3 fw-bold">Albums</h3>

<!-- Home Button -->
<NavLink class="icon-button" href="/" title="Home">
    <span class="bi bi-house-door"></span>
</NavLink>

@if (albums == null)
{
    <p>Loading albums...</p>
}
else
{
    <table class="table table-hover mt-3">
        <thead class="table-light">
            <tr>
                <th>Album Photo</th>
                <th>Album Title</th>
                <th>Created By</th>
                <th>From Company</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in albums)
            {
                <tr>
                    <td>
                        <img src="@album.ThumbnailUrl" alt="Album Thumbnail"
                            style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                    </td>
                    <td>@album.Title</td>
                    <td>@album.CreatedBy</td>
                    <td>@album.FromCompany</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AlbumDto> albums = new();

    protected override async Task OnInitializedAsync()
    {
        albums = await AlbumService.GetAlbumsAsync() ?? new List<AlbumDto>();
    }
}
