@page "/posts"
@inject NavigationManager Navigation
@inject PostService PostService
@rendermode InteractiveServer

@using DataExplorerModels;

<h3 class="mt-3 fw-bold">Posts</h3>


<NavLink class="icon-button" href="/" title="Home">
    <span class="bi bi-house-door"></span>
</NavLink>


@if (posts == null)
{
    <p>Loading posts...</p>
}
else
{
    @foreach (var post in posts)
    {
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom"
                @onclick="@(() => TogglePost(post))" style="cursor: pointer; padding: 1rem;">
                <h5 class="mb-0 fw-semibold">@post.Title</h5>
                <span class="@GetExpandIcon(post.IsExpanded)" style="font-size: 1.2rem;"></span>
            </div>

            @if (post.IsExpanded)
            {
                <div class="card-body">
                    <p class="text-secondary">@post.Body</p>
                </div>
            }
        </div>
    }
}

@code {
    private List<Post> posts = new();

    protected override async Task OnInitializedAsync()
    {
        posts = await PostService.GetPostsAsync() ?? new List<Post>();
    }

    private void TogglePost(Post post)
    {
        post.IsExpanded = !post.IsExpanded;
        StateHasChanged();
    }

    private string GetExpandIcon(bool isExpanded)
    {
        return isExpanded ? "bi bi-chevron-up" : "bi bi-chevron-down";
    }
}
